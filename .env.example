# ===== 智能问答系统 .env 模板（脱敏）=====
# 用法: cp .env.example .env 后填写。本文件不含真实密钥，请勿放入任何真实凭据。
# 说明: .env 只承载 密钥/服务商/模型；库、向量库、检索参数等在 documents/data/config.ini。

# 服务商 API Key（必填，当前示例为 SiliconFlow）
DASHSCOPE_API_KEY=

# 服务商 OpenAI 兼容地址
DASHSCOPE_BASE_URL=https://api.siliconflow.cn/v1

# LLM 与嵌入模型
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
EMBEDDING_MODEL=BAAI/bge-m3
